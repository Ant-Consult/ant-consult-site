{
  "redirects": [
    { "source": "/about-us", "destination": "/about.html", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/our-approach", "destination": "/aim.html", "permanent": true },
    { "source": "/aim", "destination": "/aim.html", "permanent": true },
    { "source": "/services", "destination": "/solutions.html", "permanent": true },
    { "source": "/our-work", "destination": "/projects.html", "permanent": true },
    { "source": "/resources", "destination": "/insights.html", "permanent": true },
    { "source": "/blog", "destination": "/insights.html", "permanent": true },
    { "source": "/get-in-touch", "destination": "/contact.html", "permanent": true },
    { "source": "/whoweare", "destination": "/about.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/ant-implementation-method", "destination": "/aim.html", "permanent": true },
    { "source": "/workwithus", "destination": "/solutions.html", "permanent": true },
    { "source": "/case-studies", "destination": "/projects.html", "permanent": true },
    { "source": "/faqs", "destination": "/contact.html", "permanent": true },
    { "source": "/cost-estimators", "destination": "/tools/services-cost-estimator.html", "permanent": true },
    { "source": "/blog/:slug([^.]+)", "destination": "/blog/:slug.html", "permanent": true },
    { "source": "/projects/:slug([^.]+)", "destination": "/projects/:slug.html", "permanent": true },
    { "source": "/case-studies/:slug", "destination": "/projects/:slug.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.prod.website-files.com https://www.googletagmanager.com; connect-src 'self' https://hooks.zapier.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://calendly.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
